# =============================================================================
# Dhanam Organics - Apache Server Configuration for GoDaddy Hosting
# =============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Allow direct access to existing files and directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Allow direct access to api/ and uploads/
  RewriteRule ^api/ - [L]
  RewriteRule ^uploads/ - [L]
  RewriteRule ^php/ - [L]

  # Route all other URLs (including /admin) to index.html for React SPA handling
  RewriteRule ^ index.html [L]
</IfModule>

# Security: Protect sensitive files
<FilesMatch "^\.|\.(sql|env|log|md)$">
  Order allow,deny
  Deny from all
</FilesMatch>

# Enable gzip compression for fast 144Hz asset delivery
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>
